{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "hearsay cursor session-start --session-id {{sessionId}} --namespace {{projectNamespace}} --agent-id cursor:{{model}}:{{sessionId}}",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "hearsay cursor pre-tool-use --session-id {{sessionId}} --tool {{toolName}} --input '{{toolInputJson}}' --on-conflict warn",
        "timeout": 5,
        "matcher": "Read|Write|Edit|Bash"
      }
    ],
    "postToolUse": [
      {
        "command": "hearsay cursor post-tool-use --session-id {{sessionId}} --tool {{toolName}} --input '{{toolInputJson}}'",
        "timeout": 5,
        "matcher": "Read|Write|Edit|Bash"
      }
    ],
    "sessionEnd": [
      {
        "command": "hearsay cursor session-end --session-id {{sessionId}}",
        "timeout": 5
      }
    ]
  }
}
